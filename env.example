# Образец .env для docker compose: скопируйте файл в .env рядом с compose.yaml и поменяйте нужные строки.
# Приложение само .env не читает. Без Docker переменные задаются в оболочке, порт — ключом --port uvicorn.

# Порт на машине пользователя для docker compose; в контейнере сервис всегда слушает 8000
APP_PORT=8000
# synthetic — синтетический каталог из комплекта, sqlite — копия выгрузки, file — JSON в каноническом формате.
# Пусто: synthetic, а с наложением compose.data.yaml — sqlite
CATALOG_SOURCE=
# Пути к файлам каталога: в Docker — внутри контейнера, папка с данными видна там как /data; без Docker — на диске.
# Пусто с compose.data.yaml: /data/catalog.sqlite3 и /data/catalog-signals.sqlite3
CATALOG_PATH=
CATALOG_SIGNALS_PATH=
CATALOG_MAPPING=
# Пары совместных записей на курсы для «похожих курсов» (JSON). Пусто: synthetic берёт пары из комплекта,
# sqlite и file остаются без пар, а с compose.data.yaml — /data/course-pairs.json. Нет файла — признак отключён
CATALOG_PAIRS_PATH=
# Сколько слушателей должны быть записаны на оба курса, чтобы пара учитывалась, от 1 до 1000000. Пусто: 10
PAIRS_MIN_SUPPORT=
# Папка с копией выгрузки на этой машине; нужна только для compose.data.yaml
LOCAL_DATA_DIR=
# Тестовые профили и режим сравнения: true, false, 1, 0, yes, no, on или off
DEMO_MODE=true
# Необязательный JSON с демонстрационными профилями. В Docker укажите путь внутри контейнера.
DEMO_PROFILES_PATH=
# Предел длины задачи, от 1 до 2000 символов
MAX_TASK_LENGTH=300
# Адрес /metrics со счётчиком запросов и гистограммой длительности в формате Prometheus: true, false, 1, 0, yes,
# no, on или off. Выключено: /metrics отвечает 404 и счётчики не ведутся. Аутентификации у адреса нет, как и у API
METRICS_ENABLED=false
# Уровень журнала приложения и uvicorn: debug, info, warning, error или critical, регистр не важен.
# Неверное значение CATALOG_SOURCE, PAIRS_MIN_SUPPORT, DEMO_MODE, MAX_TASK_LENGTH, METRICS_ENABLED или LOG_LEVEL
# останавливает запуск с сообщением, где названа переменная
LOG_LEVEL=info
